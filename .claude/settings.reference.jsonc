{
  // ─────────────────────────────────────────────
  // РАЗРЕШЕНИЯ
  // Управляют тем, какие инструменты Claude выполняет
  // автоматически, а какие — только с подтверждением.
  // ─────────────────────────────────────────────
  "permissions": {
    // Паттерны инструментов без подтверждения.
    // Формат: "ToolName(glob-паттерн-аргумента)"
    //   "Bash(*)"          — любая bash-команда
    //   "Bash(go test *)"  — только go test
    //   "Bash(git *)"      — любые git-команды
    //   "Read(*)"          — чтение любых файлов
    //   "mcp__github__*"   — все GitHub MCP-инструменты
    "allow": [
      "Bash(claude mcp:*)",
      "Skill(update-config)",
      "Bash(gh api *)",
      "Bash(gh repo *)"
    ],

    // Паттерны, которые ВСЕГДА блокируются — даже если пользователь
    // одобрил их в сессии. Защита от деструктивных операций.
    "deny": [
      // "Bash(rm -rf *)",
      // "Bash(git push --force *)"
    ]
  },

  // ─────────────────────────────────────────────
  // ХУКИ
  // Shell-команды, запускаемые автоматически при событиях.
  // Harness запускает их, Claude не контролирует.
  // Вывод в stderr = блокировка инструмента (для PreToolUse).
  // ─────────────────────────────────────────────
  "hooks": {
    // Срабатывает ДО вызова инструмента.
    // Используй для: логирования, аудита, блокировки опасных команд.
    // matcher: glob по имени ("Bash", "Edit", "Bash(rm *)")
    "PreToolUse": [
      // {
      //   "matcher": "Bash",
      //   "hooks": [
      //     { "type": "command", "command": "echo '[hook] Bash: ' >> /tmp/audit.log" }
      //   ]
      // }
    ],

    // Срабатывает ПОСЛЕ вызова инструмента.
    // Используй для: авто-сборки, линтера, уведомлений.
    "PostToolUse": [
      // {
      //   "matcher": "Edit",
      //   "hooks": [
      //     { "type": "command", "command": "go build ./... 2>&1" }
      //   ]
      // }
    ],

    // Срабатывает когда Claude завершает ответ.
    // Используй для: уведомлений о завершении долгих задач.
    "Stop": [
      // {
      //   "hooks": [
      //     {
      //       "type": "command",
      //       "command": "powershell -Command \"[System.Windows.Forms.MessageBox]::Show('Claude готов!')\""
      //     }
      //   ]
      // }
    ],

    // Срабатывает при отправке сообщения пользователем.
    // Используй для: добавления контекста к каждому промпту.
    "UserPromptSubmit": [
      // {
      //   "hooks": [
      //     { "type": "command", "command": "git branch --show-current" }
      //   ]
      // }
    ],

    // Срабатывает при системном уведомлении.
    "Notification": [],

    // Срабатывает когда subagent завершает работу.
    "SubagentStop": []
  },

  // ─────────────────────────────────────────────
  // ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
  // Доступны Claude и всем командам которые он запускает.
  // Не храни секреты здесь — файл попадает в git!
  // ─────────────────────────────────────────────
  "env": {
    // "GO_ENV": "development",
    // "LOG_LEVEL": "debug"
  },

  // ─────────────────────────────────────────────
  // МОДЕЛЬ
  // Модель по умолчанию для проекта.
  // claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
  // ─────────────────────────────────────────────
  // "model": "claude-sonnet-4-6",

  // ─────────────────────────────────────────────
  // ХРАНЕНИЕ ИСТОРИИ
  // Сколько дней хранить локальные логи сессий. По умолчанию: 30
  // ─────────────────────────────────────────────
  // "cleanupPeriodDays": 30,

  // ─────────────────────────────────────────────
  // CO-AUTHORED-BY В КОММИТАХ
  // Добавлять ли "Co-Authored-By: Claude" в git-коммиты. По умолчанию: true
  // ─────────────────────────────────────────────
  // "includeCoAuthoredBy": true,

  // ─────────────────────────────────────────────
  // API КЛЮЧ через команду (альтернатива ANTHROPIC_API_KEY)
  // Удобно для интеграции с секрет-менеджерами.
  // ─────────────────────────────────────────────
  // "apiKeyHelper": "aws secretsmanager get-secret-value --secret-id my-key --query SecretString --output text"
}
